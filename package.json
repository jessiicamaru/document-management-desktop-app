{
  "name": "study-docs",
  "productName": "Study Docs",
  "version": "0.2.0",
  "description": "Quản lý tài liệu học (Markdown + HTML) trên Windows",
  "author": "",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "local.studydocs.app",
    "productName": "Study Docs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Study Docs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jessiicamaru",
        "repo": "document-management-desktop-app",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
